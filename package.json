{
  "name": "tokiwagi-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "exports": {
    "./astro": "./src/astro/index.ts",
    "./react": "./src/react/index.ts",
    "./vue": "./src/vue/index.ts",
    "./tokens/*.css": "./tokens/*.css"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": ">=3.5.0 <4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "bun --bun astro dev",
    "dev:all": "ASTRO_DEV_BACKGROUND=0 bun run --parallel dev storybook",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "check": "bun --bun astro check",
    "test": "bun test",
    "generate:icons": "bun scripts/generate-icons.ts",
    "check:react-compat": "bun scripts/check-react-compat.ts",
    "storybook": "storybook dev --port 6006 --host localhost --no-open",
    "build:storybook": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "0.4.1",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/html-vite": "10.6.0",
    "@types/bun": "^1.3.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vue/server-renderer": "3.5.22",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "vue": "3.5.22"
  }
}
