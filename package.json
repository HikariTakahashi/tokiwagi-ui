{
  "name": "tokiwagi-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun --bun astro dev",
    "dev:all": "ASTRO_DEV_BACKGROUND=0 bun run --parallel dev storybook",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "check": "bun --bun astro check",
    "test": "bun test",
    "storybook": "storybook dev --port 6006 --host localhost --no-open",
    "build:storybook": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/html-vite": "10.6.0",
    "@types/bun": "1.3.9",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.0",
    "typescript": "5.9.3"
  }
}
