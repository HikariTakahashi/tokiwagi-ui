---
import { resolveBrandText, brandStyle, brandNameStyle } from '../lib/brand';
import TLogo from './TLogo.astro';
import TText from './TText.astro';
import type { TBrandProps } from './TBrandProps';

interface Props extends TBrandProps {}

const { text, size = 32, class: className } = Astro.props;
const brandText = resolveBrandText(text);
---
<span class={className} style={brandStyle}>
  <TLogo size={size} decorative />
  <TText as="span" tone="inherit" style={brandNameStyle}>{brandText}</TText>
</span>
