---
import type { TLinkButtonProps } from './TLinkButtonProps';
import { linkState } from '../lib/link';
import { linkButtonSizeState } from '../lib/link-size';
import TIcon from './TIcon.astro';
interface Props extends TLinkButtonProps {}
const { href, tone, size, leadingIcon, trailingIcon, target, rel, class: className, ...attributes } = Astro.props;
const sizing = linkButtonSizeState(size);
const state = linkState({ href, tone, leadingIcon, trailingIcon, target: target ?? undefined, rel: rel ?? undefined,
  'aria-current': attributes['aria-current'] ?? undefined }, 'TLinkButton');
---
<a {...attributes} href={state.href} target={target} rel={state.rel} class:list={['tkw-button', 'tkw-link-button', className]}
  data-size={sizing.size} data-tone={state.tone} data-current={state.isCurrent || undefined}>{state.leadingIcon !== undefined && <span class="tkw-button__icon tkw-link-button__leading-icon"><TIcon name={state.leadingIcon} size={sizing.iconSize} /></span>}<span class="tkw-button__label tkw-link-button__label"><slot /></span>{state.trailingIcon !== undefined && <span class="tkw-button__icon tkw-link-button__trailing-icon"><TIcon name={state.trailingIcon} size={sizing.iconSize} /></span>}</a>
