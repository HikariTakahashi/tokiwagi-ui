---
import type { TLinkProps } from './TLinkProps';
import { linkState } from '../lib/link';
import TIcon from './TIcon.astro';
interface Props extends TLinkProps {}
const { href, tone, leadingIcon, trailingIcon, target, rel, class: className, ...attributes } = Astro.props;
const state = linkState({ href, tone, leadingIcon, trailingIcon, target: target ?? undefined, rel: rel ?? undefined,
  'aria-current': attributes['aria-current'] ?? undefined });
---
<a {...attributes} href={state.href} target={target} rel={state.rel} class:list={['tkw-link', className]}
  data-tone={state.tone} data-current={state.isCurrent || undefined}>{state.leadingIcon !== undefined && <span class="tkw-link__leading-icon"><TIcon name={state.leadingIcon} size={16} /></span>}<span class="tkw-link__label"><slot /></span>{state.trailingIcon !== undefined && <span class="tkw-link__trailing-icon"><TIcon name={state.trailingIcon} size={16} /></span>}</a>
