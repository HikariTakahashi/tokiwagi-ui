---
import { iconSizes, renderIconSvg } from '../lib/icon-assets';
import { iconSources, isIconName } from '../lib/icon-sources';
import type { TIconProps } from './TIconProps';

interface Props extends TIconProps {}

const { name, size = 24, color = 'currentColor', class: className } = Astro.props;
if (!isIconName(name)) throw new Error(`存在しないアイコン公開名: ${name}`);
if (!iconSizes.includes(size)) throw new Error(`アイコンのサイズは16/20/24/32pxから選択してください: ${size}`);
// 静的出力時に確定するID。並行レンダリングや別ページのHTMLの合成でも衝突を避ける。
const svg = renderIconSvg(iconSources[name], `tkw-astro-${crypto.randomUUID()}`, size);
const body = svg.slice(svg.indexOf('>') + 1, svg.lastIndexOf('</svg>'));
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  fill="none"
  width={size}
  height={size}
  class={className}
  style={{ color, display: 'inline-block', flexShrink: 0, verticalAlign: 'middle' }}
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
