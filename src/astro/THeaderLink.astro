---
import type { THeaderLinkProps } from './THeaderLinkProps';
import { headerLinkState } from '../lib/header-link';
interface Props extends THeaderLinkProps {}
const { href, tone, iconOnly, target, rel, class: className, ...attributes } = Astro.props;
const state = headerLinkState({ href, tone, iconOnly, target: target ?? undefined, rel: rel ?? undefined, 'aria-current': attributes['aria-current'] ?? undefined });
---
<a {...attributes} href={state.href} target={target} rel={state.rel} class:list={['tkw-header-button', 'tkw-header-link', className]}
  data-tone={state.tone} data-icon-only={state.iconOnly || undefined} data-selected={state.selected || undefined}><slot /></a>
