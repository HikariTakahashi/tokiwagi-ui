---
import '../styles/global.css';
import 'tokiwagi-ui/header.css';
import { TBrand, THeader, THeaderLink, THeaderSection, TIcon } from 'tokiwagi-ui/astro';
import ColorCodeExample from '../components/ColorCodeExample.astro';
import type { SemanticColor } from '../lib/color-code-example';
import rawPrimary from '../../tokens/colors.css?raw';
import rawSecondary from '../../tokens/secondary.css?raw';
import rawSemantic from '../../tokens/semantic.css?raw';
import rawNeutral from '../../tokens/neutrals.css?raw';
import {
  colors, neutrals, neutralTokenName, parseNeutralTokens,
  parseSecondaryTokens, parseSemanticTokens, parseTokens, secondaryColors,
  primaryForegroundTokenName,
  secondaryTokenName, semanticColors, semanticTokenName, tokenName, variants,
} from '../lib/palette';

type PaletteColor = {
  name: string;
  token: string;
  purpose?: string;
  semantic?: SemanticColor;
};

type Palette = {
  id: string;
  title: string;
  description: string;
  guidelineDescription: string;
  layout: 'rows' | 'neutral';
  swatches: PaletteColor[];
};

const tokens = {
  ...parseTokens(rawPrimary),
  ...parseSecondaryTokens(rawSecondary),
  ...parseSemanticTokens(rawSemantic),
  ...parseNeutralTokens(rawNeutral),
};

const palettes: Palette[] = [
  {
    id: 'primary',
    layout: 'rows',
    title: 'プライマリー',
    description: '主要操作、カテゴリ、選択状態に使う7色です。プロジェクトや画面の文脈に合わせて選びます。',
    guidelineDescription: '主要操作、カテゴリ、選択状態に使います。7色を対等に扱い、プロジェクトや画面の文脈に合わせて選びます。',
    swatches: colors.map(([key, name]) => ({ name, token: tokenName(key) })),
  },
  {
    id: 'secondary',
    layout: 'rows',
    title: 'セカンダリー',
    description: '装飾、分類、補助的な強調に使う3色です。通常・ホバー・押下は白文字、淡い背景は同系色の濃い文字を組み合わせます。いずれもコントラスト比は4.5:1以上です。',
    guidelineDescription: '補助的な強調や分類、装飾に使います。',
    swatches: secondaryColors.map(([key, name, purpose]) => ({ name, purpose, token: secondaryTokenName(key) })),
  },
  {
    id: 'semantic',
    layout: 'rows',
    title: 'セマンティック（状態色）',
    description: '成功・警告・エラー・情報を伝える色です。同じ状態には、画面をまたいで同じ意味と色を使います。',
    guidelineDescription: '成功・警告・エラー・情報を表します。',
    swatches: semanticColors.map(([key, name, purpose]) => ({
      name, purpose, token: semanticTokenName(key), semantic: key,
    })),
  },
  {
    id: 'neutral',
    layout: 'neutral',
    title: 'ニュートラル',
    description: '背景、境界線、文字、無効状態を支える9段階です。見出しは900、本文は800、補助テキストは600を基本に使います。',
    guidelineDescription: '背景、境界線、文字、無効状態を支えます。',
    swatches: neutrals.map(([step, purpose]) => ({
      name: step, purpose, token: neutralTokenName(step),
    })),
  },
];

const paletteGuidelines = palettes.map(({ id, title, guidelineDescription, swatches }) => ({
  title: id === 'semantic' ? 'セマンティック' : title,
  description: guidelineDescription,
  swatches: id === 'neutral'
    ? swatches.filter(({ name }) => ['0', '200', '800', '1000'].includes(name))
    : swatches.slice(0, 4),
}));

const stateSwatches = variants.map(([suffix, label]) => {
  const background = tokenName('green', suffix);
  const foreground = primaryForegroundTokenName('green', suffix);
  return {
    label: suffix === '' ? '標準' : suffix === '-subtle' ? '淡い色' : label,
    english: suffix.slice(1) || 'normal',
    background,
    foreground,
  };
});

---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content="Tokiwagi UI のカラーの選び方、色見本、操作状態と背景・文字の組み合わせ。" />
    <title>カラー | Tokiwagi UI</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <THeader class="sticky top-0 z-10" scrollLabel="サイトヘッダーナビゲーション">
      <THeaderSection position="left">
        <a class="brand-link" href="/" aria-label="Tokiwagi UI ホーム"><TBrand /></a>
      </THeaderSection>
      <THeaderSection position="right">
        <nav class="flex" aria-label="サイトナビゲーション">
          <THeaderLink href="/#foundations">基盤</THeaderLink>
          <THeaderLink href="/colors/" aria-current="page">カラー</THeaderLink>
        </nav>
      </THeaderSection>
    </THeader>

    <div class="page-shell">
      <main id="main" tabindex="-1">
        <header class="hero">
          <div>
            <div class="hero-title-row">
              <h1>カラー</h1>
              <a class="storybook-button" href="http://localhost:6006/?path=/docs/カラー-使用ルール--docs" target="_blank" rel="noopener noreferrer">
                Storybookを見る <TIcon name="chevron-right" size={16} />
              </a>
            </div>
            <p>Tokiwagi UIの「日々に寄り添う使いやすさ」を実現するためのカラー設計です。</p>
          </div>
        </header>

        <section class="page-section" id="states" aria-labelledby="states-title" tabindex="-1">
          <div class="section-heading">
            <h2 id="states-title">ガイドライン</h2>
          </div>
          <div class="color-guidelines">
            <div class="guideline-block">
              <h3>役割</h3>
              <ul class="guideline-roles" role="list">
                {paletteGuidelines.map(({ title, description, swatches }) => (
                  <li>
                    <span class="guideline-swatches" role="img" aria-label={`${title}の色見本：${swatches.map(({ name }) => name).join('・')}`}>
                      {swatches.map(({ token }) => (
                        <span class:list={['guideline-chip', { 'is-white': token === neutralTokenName('0') }]} style={{ background: `var(${token})` }} aria-hidden="true" />
                      ))}
                    </span>
                    <p><strong>{title}</strong>：{description}</p>
                  </li>
                ))}
              </ul>
            </div>
            <div class="guideline-block">
              <h3>使い分け</h3>
              <p>プライマリー・セカンダリー・セマンティックには、次の4種類があります。ホバー・押下は、操作できる要素に適用します。</p>
              <ul class="guideline-states" role="list" aria-label="グリーンを使った4種類の色の見本">
                {stateSwatches.map(({ label, english, background, foreground }) => (
                  <li style={{ background: `var(${background})`, color: `var(${foreground})` }}>
                    <span>{label}</span>
                    <span class="guideline-english">({english})</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <nav class="palette-nav" aria-label="色の系統">
          {palettes.map(({ id, title, swatches }) => (
            <a href={`#${id}`}>
              <span class="palette-strip" aria-hidden="true">
                {swatches.map(({ token }) => <span style={{ background: `var(${token})` }} />)}
              </span>
              <span>{id === 'semantic' ? '状態色' : title} <span aria-hidden="true">↓</span></span>
            </a>
          ))}
        </nav>

        {palettes.map(palette => (
          <section class="page-section" id={palette.id} aria-labelledby={`${palette.id}-title`} tabindex="-1">
            <div class="section-heading">
              <h2 id={`${palette.id}-title`}>{palette.title}</h2>
              <p>{palette.description}</p>
            </div>
            {palette.layout === 'rows' ? (
              <ul class="palette-rows" role="list">
                {palette.swatches.map(({ name, token, purpose, semantic }) => (
                  <li class="palette-row">
                    <h3>{name}</h3>
                    {purpose && <p>{purpose}</p>}
                    <ColorCodeExample name={name} token={token} tokens={tokens} semantic={semantic} />
                  </li>
                ))}
              </ul>
            ) : (
              <div class="palette-row">
                <ColorCodeExample name="ニュートラル" token={neutralTokenName('50')} tokens={tokens} neutral />
              </div>
            )}
          </section>
        ))}

        <section class="page-section" id="accessibility" aria-labelledby="accessibility-title" tabindex="-1">
          <div class="section-heading">
            <h2 id="accessibility-title">アクセシビリティ</h2>
          </div>
          <ul class="guidelines">
            <li>状態や選択には、色に加えて文言・アイコン・チェックマークを使います。</li>
            <li>プライマリーの通常・ホバー色と白は <strong>3:1以上</strong>です。24px以上の太字ラベルなど、大きな文字やアイコンに使います。</li>
            <li>通常サイズの文字には <strong>4.5:1以上</strong>を確保します。プライマリーの押下色と白、淡い背景と濃い文字はこの基準を満たします。</li>
            <li>ボタンやリンクのフォーカスは、キーボード操作中に位置が分かるように枠などで示します。</li>
          </ul>
        </section>
      </main>

      <footer>
        <a class="text-link" href="/#foundations"><span aria-hidden="true">←</span> 基盤に戻る</a>
        <a class="text-link" href="#main">ページの先頭へ <span aria-hidden="true">↑</span></a>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(html) {
    background: var(--tkw-color-neutral-50);
    color: var(--tkw-color-neutral-900);
    color-scheme: light;
    scroll-padding-top: 52px;
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.65; }
  h1, h2, h3, p { margin: 0; }
  h1, h2 { line-height: 1.25; letter-spacing: -.04em; }
  h1 { font-size: clamp(3rem, 6vw, 5rem); }
  h2 { font-size: clamp(1.65rem, 3vw, 2.5rem); }
  h3 { font-size: 1rem; }
  p { color: var(--tkw-color-neutral-800); text-wrap: pretty; }
  a { color: inherit; }
  a:focus-visible {
    outline: 2px solid var(--tkw-color-neutral-900);
    outline-offset: 4px;
  }
  .brand-link { display: inline-flex; text-decoration: none; }
  .brand-link:focus-visible { outline-offset: -2px; }
  .skip-link {
    position: absolute;
    top: -100px;
    left: 16px;
    z-index: 20;
    padding: 10px 14px;
    background: var(--tkw-color-neutral-0);
  }
  .skip-link:focus { top: 8px; }
  .page-shell { width: min(100% - clamp(32px, 8vw, 96px), 1200px); margin-inline: auto; }
  main { min-width: 0; }
  .hero {
    padding-block: clamp(32px, 4vw, 56px);
  }
  .hero p { margin-top: 18px; }
  .hero-title-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .storybook-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 7px;
    background: var(--tkw-color-neutral-900);
    color: var(--tkw-color-neutral-0);
    font-size: .875rem;
    font-weight: 650;
    text-decoration: none;
    margin-inline-start: auto;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .storybook-button:hover { background: var(--tkw-color-neutral-800); }
  .storybook-button:active { background: var(--tkw-color-neutral-1000); }
  .text-link { font-weight: 650; text-underline-offset: 4px; }
  .text-link:hover { text-decoration-thickness: 2px; }
  .palette-nav { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .palette-nav a {
    display: grid;
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--tkw-color-neutral-200);
    border-radius: 12px;
    background: var(--tkw-color-neutral-0);
    font-size: .875rem;
    font-weight: 650;
    text-decoration: none;
  }
  .palette-nav a:hover { background: var(--tkw-color-neutral-100); }
  .palette-nav a:active { background: var(--tkw-color-neutral-200); }
  .palette-nav a > span:last-child { display: flex; justify-content: space-between; gap: 4px; }
  .palette-strip { display: flex; height: 34px; border-radius: 5px; overflow: hidden; }
  .palette-strip span { flex: 1; }
  .page-section { padding-block: clamp(32px, 6vw, 64px); border-top: 1px solid var(--tkw-color-neutral-200); }
  .section-heading { display: grid; gap: 10px; margin-bottom: 24px; }
  .section-heading p { max-width: none; }
  .section-heading p code { white-space: nowrap; }
  .palette-rows {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .palette-row {
    min-width: 0;
    padding: clamp(8px, 2vw, 16px);
    border: 1px solid var(--tkw-color-neutral-200);
    border-radius: 12px;
    background: var(--tkw-color-neutral-0);
  }
  .palette-row > p { margin-top: 2px; font-size: .875rem; }
  .color-guidelines { display: grid; gap: 28px; }
  .guideline-block { display: grid; gap: 14px; min-width: 0; }
  .guideline-block > h3 { font-size: 1.125rem; }
  .guideline-roles { display: grid; gap: 18px; margin: 0; padding: 0; list-style: none; }
  .guideline-roles li { display: grid; grid-template-columns: 84px minmax(0, 1fr); align-items: baseline; gap: 14px; }
  .guideline-swatches { display: flex; align-items: center; gap: 4px; position: relative; top: 3px; }
  .guideline-chip { flex: 0 0 18px; width: 18px; height: 18px; border-radius: 3px; }
  .guideline-chip.is-white { box-shadow: inset 0 0 0 1px var(--tkw-color-neutral-200); }
  .guideline-roles strong { color: var(--tkw-color-neutral-900); }
  .guideline-states { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 2px 0 0; padding: 0; list-style: none; }
  .guideline-states li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 4px;
    min-height: 116px;
    padding: 16px;
    border-radius: 8px;
    font-size: max(24px, 1.5rem);
    line-height: 1.4;
    font-weight: 700;
  }
  .guideline-english { font-size: max(19px, 1.1875rem); }
  .guidelines { display: grid; gap: 8px; margin: 0; padding-inline-start: 1.5em; }
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 24px;
    border-top: 1px solid var(--tkw-color-neutral-200);
    font-size: .875rem;
  }
  @media (max-width: 680px) {
    .palette-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .hero-title-row h1 { font-size: clamp(2rem, 10vw, 2.5rem); }
    .guideline-roles li { display: block; }
    .guideline-roles p { display: inline; }
    .guideline-swatches { display: inline-flex; width: 76px; margin-inline-end: 8px; }
    .guideline-chip { flex-basis: 16px; width: 16px; height: 16px; }
    .guideline-states { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .guideline-states li { padding: 14px; }
  }
</style>
