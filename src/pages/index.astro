---
import '../styles/global.css';
import 'tokiwagi-ui/header.css';
import 'tokiwagi-ui/card.css';
import 'tokiwagi-ui/link.css';
import 'tokiwagi-ui/link-button.css';
import 'tokiwagi-ui/text.css';
import { TCard, TCardActionArea, TCardHeader, TCardTitle, TCardDescription, TCardFooter, TBrand, THeader, THeaderLink, THeaderSection, TLink, TLinkButton, TText } from 'tokiwagi-ui/astro';
import { colors } from '../lib/palette';
import { iconsByName } from '../lib/icon-catalog';
import { renderIconSvg } from '../lib/icon-assets';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content="変わる毎日に、変わらない使いやすさを。Tokiwagi UI は、色・アイコン・コンポーネントと、その使い方をそろえるデザインシステムです。部品とルールの積み重ねを、次の体験へつなぎます。" />
    <title>Tokiwagi UI — 変わる毎日に、変わらない使いやすさを。</title>
  </head>
  <body>
    <a class="skip-link" href="#main"><TText inherit tone="inherit">本文へスキップ</TText></a>
    <THeader class="sticky top-0 z-10" scrollLabel="サイトヘッダーナビゲーション">
      <THeaderSection position="left">
        <TBrand />
      </THeaderSection>
      <THeaderSection position="right">
        <nav class="flex" aria-label="ページ内ナビゲーション" data-section-navigation>
          <THeaderLink href="#principles"><TText inherit tone="inherit" style="white-space: inherit">デザインの考え方</TText></THeaderLink>
          <THeaderLink href="#foundations"><TText inherit tone="inherit" style="white-space: inherit">基盤</TText></THeaderLink>
          <THeaderLink href="/components/"><TText inherit tone="inherit" style="white-space: inherit">コンポーネント</TText></THeaderLink>
          <THeaderLink href="http://localhost:6006/" target="_blank" rel="noopener noreferrer"><TText inherit tone="inherit" style="white-space: inherit">Storybook</TText> <span aria-hidden="true"><TText inherit tone="inherit" style="white-space: inherit">↗</TText></span></THeaderLink>
        </nav>
      </THeaderSection>
    </THeader>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-line"></span><TText inherit tone="inherit"> A DESIGN SYSTEM FOR EVERYDAY MOMENTS</TText></div>
          <h1 id="hero-title"><TText inherit tone="inherit">変わる毎日に、<br /><em>変わらない使いやすさを。</em></TText></h1>
          <p class="hero-lead"><TText inherit tone="inherit">Tokiwagi UI は、色・アイコン・コンポーネントと、その使い方をそろえるデザインシステムです。<br />ひとつひとつの部品とルールを積み重ね、日々に寄り添う使いやすさを、次の体験へつなぎます。</TText></p>
          <div class="hero-actions">
            <TLinkButton size="sm" tone="neutral-900" weight="normal" href="http://localhost:6006/" target="_blank" rel="noopener noreferrer" trailingIcon="arrow-top-right"><TText inherit tone="inherit">Storybook で見る</TText></TLinkButton>
            <TLink class="text-link" href="#foundations"><TText inherit tone="inherit">基盤について見る <span aria-hidden="true">↓</span></TText></TLink>
            <TLink class="text-link" href="/components/"><TText inherit tone="inherit">コンポーネントを見る</TText></TLink>
          </div>
          <p class="local-note"><TText inherit tone="inherit">ローカルで <code>bun run storybook</code> を起動すると閲覧できます。</TText></p>
        </div>
        <div class="hero-art" aria-label="7色のプライマリーカラー">
          <div class="art-grid">{colors.map(([key, name], index) => <div class="art-card" style={`--card-color:var(--tkw-color-primary-${key});--card-ink:var(--tkw-color-primary-${key}-on);--card-angle:${(index - 3) * 2}deg`}><span class="art-index"><TText inherit tone="inherit">0{index + 1}</TText></span><span class="art-letter" aria-hidden="true"><TText inherit tone="inherit">t.</TText></span><span class="art-name"><TText inherit tone="inherit">{name}</TText></span></div>)}</div>
          <div class="art-caption"><span><TText inherit tone="inherit">SEVEN EQUAL COLORS</TText></span><span><TText inherit tone="inherit">LIGHT THEME / 01</TText></span></div>
        </div>
      </section>

      <section class="principles section-shell" id="principles" aria-labelledby="principles-title">
        <div class="section-intro"><span class="section-kicker"><TText inherit tone="inherit">01 / PRINCIPLES</TText></span><h2 id="principles-title"><TText inherit tone="inherit">それぞれの色に、<br />それぞれの出番。</TText></h2><p><TText inherit tone="inherit">ひとつの色を主役に決めず、使う場面に合わせて選ぶ。状態を色だけに頼らず、ことばやアイコンでも伝える。毎日の操作に一貫した手がかりを作ります。</TText></p></div>
        <div class="principle-list">
          <article><span class="principle-number"><TText inherit tone="inherit">01</TText></span><div><h3><TText inherit tone="inherit">7色は対等な主役</TText></h3><p><TText inherit tone="inherit">プロジェクトやカテゴリごとに選び、同じ対象には同じ色を使います。</TText></p></div></article>
          <article><span class="principle-number"><TText inherit tone="inherit">02</TText></span><div><h3><TText inherit tone="inherit">意味はいつも同じ</TText></h3><p><TText inherit tone="inherit">成功・警告・エラー・情報は、専用の状態色と説明を組み合わせます。</TText></p></div></article>
          <article><span class="principle-number"><TText inherit tone="inherit">03</TText></span><div><h3><TText inherit tone="inherit">見て、確かめて、作る</TText></h3><p><TText inherit tone="inherit">トークン、操作状態、文字とのコントラストを Storybook で確認できます。</TText></p></div></article>
        </div>
      </section>

      <section class="foundations section-shell" id="foundations" aria-labelledby="foundations-title">
        <div class="section-topline"><span class="section-kicker"><TText inherit tone="inherit">02 / FOUNDATIONS</TText></span><span><TText inherit tone="inherit">THE BUILDING BLOCKS</TText></span></div>
        <div class="foundations-heading"><h2 id="foundations-title"><TText inherit tone="inherit">つくるための、<br />共通の基盤。</TText></h2><p><TText inherit tone="inherit">カラーの選び方と組み合わせ、アイコンの命名と用途を確認できます。</TText></p></div>
        <div class="foundation-grid">
          <TCard as="article" class="foundation-card color-card" size="lg" aria-labelledby="foundation-colors-title">
            <TCardActionArea class="foundation-action" href="/colors/" aria-labelledby="foundation-colors-title">
              <TCardHeader class="foundation-header">
                <div class="foundation-card-top"><span><TText inherit tone="inherit">01 / COLORS</TText></span><span><TText inherit tone="inherit">確定</TText></span></div>
                <div class="color-mini" aria-hidden="true">{colors.map(([key]) => <span style={`background:var(--tkw-color-primary-${key})`}></span>)}</div>
                <TCardTitle id="foundation-colors-title" class="foundation-title"><TText inherit tone="inherit">カラー</TText></TCardTitle>
                <TCardDescription class="foundation-description"><TText inherit tone="inherit">プライマリー、セカンダリー、状態色、ニュートラル。色見本と用途、背景と文字の組み合わせを確認できます。</TText></TCardDescription>
              </TCardHeader>
              <TCardFooter class="foundation-footer"><span class="foundation-link"><TText inherit tone="inherit">カラーを詳しく見る <span aria-hidden="true">→</span></TText></span></TCardFooter>
            </TCardActionArea>
          </TCard>
          <TCard as="article" class="foundation-card icon-card" size="lg" aria-labelledby="foundation-icons-title">
            <TCardHeader class="foundation-header">
              <div class="foundation-card-top"><span><TText inherit tone="inherit">02 / ICONS</TText></span><span><TText inherit tone="inherit">336 SVG</TText></span></div>
              <div class="icon-mini" aria-hidden="true">{['calendar', 'task', 'bell', 'check'].map(name => <span set:html={renderIconSvg(iconsByName.get(name)!.svg, `lp-${name}`, 32)} />)}</div>
              <TCardTitle id="foundation-icons-title" class="foundation-title"><TText inherit tone="inherit">アイコン</TText></TCardTitle>
              <TCardDescription class="foundation-description"><TText inherit tone="inherit">336個のSVGを収録。図柄・公開名・サイズ・色を一覧で確認し、個別の使用ルールを参照できます。</TText></TCardDescription>
            </TCardHeader>
            <TCardFooter class="foundation-footer"><TLink class="foundation-link" href="http://localhost:6006/?path=/docs/アイコン-アイコン名および用途--docs" target="_blank" rel="noopener noreferrer" trailingIcon="arrow-top-right"><TText inherit tone="inherit">アイコンを見る</TText></TLink></TCardFooter>
          </TCard>
        </div>
      </section>

      <section class="closing section-shell" aria-labelledby="closing-title"><div><span class="section-kicker"><TText inherit tone="inherit">START BUILDING</TText></span><h2 id="closing-title"><TText inherit tone="inherit">同じルールから、<br />新しい画面へ。</TText></h2></div><div><p><TText inherit tone="inherit">Storybook を開き、色と用途を確かめながら実装を進めます。</TText></p><TLinkButton size="sm" tone="neutral-900" weight="normal" href="http://localhost:6006/" target="_blank" rel="noopener noreferrer" trailingIcon="arrow-top-right"><TText inherit tone="inherit">Storybook を開く</TText></TLinkButton></div></section>
    </main>
    <footer><a class="brand" href="#top" aria-label="Tokiwagi UI ホーム"><TBrand /></a><span><TText inherit tone="inherit">Color with purpose, meaning with clarity.</TText></span><TLink href="#top"><TText inherit tone="inherit">ページの先頭へ <span aria-hidden="true">↑</span></TText></TLink></footer>
  </body>
</html>

<script>
  import { initializeSectionNavigation } from '../lib/section-navigation';

  initializeSectionNavigation(document, window);
</script>

<style>
  :root { background: var(--tkw-color-neutral-50); color: var(--tkw-color-neutral-900); color-scheme: light; font-synthesis: none; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 36px; }
  body { margin: 0; }
  .brand:focus-visible { outline: 3px solid var(--tkw-color-neutral-900); outline-offset: 5px; }
  .skip-link { position: absolute; top: -100px; left: 16px; z-index: 20; padding: 10px 14px; background: white; }
  .skip-link:focus { top: 12px; }
  footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; max-width: 1480px; margin: auto; padding: 24px 4.5%; }
  .brand { display: inline-flex; align-items: center; white-space: nowrap; color: inherit; text-decoration: none; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); align-items: center; gap: clamp(36px, 6vw, 100px); max-width: 1480px; min-height: 650px; margin: auto; padding: 70px 4.5% 94px; }
  .eyebrow, .section-kicker { display: inline-flex; align-items: center; gap: 10px; color: var(--tkw-color-neutral-600); font-size: 10px; font-weight: 700; letter-spacing: .15em; }
  .eyebrow-line { width: 18px; height: 1px; background: var(--tkw-color-neutral-800); }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin: 27px 0 24px; font-size: clamp(30px, 3.2vw, 52px); font-weight: 680; letter-spacing: -.085em; line-height: 1.4; }
  h1 em { font-style: normal; color: var(--tkw-color-primary-rose-on-subtle); }
  .hero-lead { color: var(--tkw-color-neutral-600); font-size: 15px; line-height: 2; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 35px; }
  .text-link { font-size: 12px; font-weight: 600; }
  .local-note { margin: 16px 0 0; color: var(--tkw-color-neutral-600); font-size: 11px; }
  .local-note code { color: var(--tkw-color-neutral-800); }
  .hero-art { min-width: 0; }
  .art-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; align-items: stretch; min-height: 350px; }
  .art-card { display: flex; flex-direction: column; justify-content: space-between; min-width: 0; padding: 12px 7px; border-radius: 7px; background: var(--card-color); color: var(--card-ink); transform: rotate(var(--card-angle)); transition: transform .25s ease; }
  .art-card:hover { transform: translateY(-9px) rotate(0); }
  .art-index, .art-name { color: var(--tkw-color-neutral-900); font-size: 9px; font-weight: 600; writing-mode: vertical-rl; }
  .art-letter { font-size: clamp(20px, 2.5vw, 39px); font-weight: 650; letter-spacing: -.08em; writing-mode: vertical-rl; }
  .art-caption { display: flex; justify-content: space-between; gap: 12px; margin-top: 17px; color: var(--tkw-color-neutral-600); font-size: 9px; letter-spacing: .14em; }
  .section-shell { max-width: 1480px; margin: auto; padding: 100px 4.5%; }
  .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 10%; border-top: 1px solid var(--tkw-color-neutral-200); }
  .section-intro h2, .foundations-heading h2, .closing h2 { margin: 21px 0; font-size: clamp(32px, 3.5vw, 56px); font-weight: 650; letter-spacing: -.065em; line-height: 1.4; }
  .section-intro > p, .foundations-heading p, .closing p { max-width: 450px; color: var(--tkw-color-neutral-600); font-size: 13px; line-height: 2; }
  .principle-list article { display: grid; grid-template-columns: 40px 1fr; gap: 18px; padding: 25px 0; border-bottom: 1px solid var(--tkw-color-neutral-200); }
  .principle-list article:first-child { border-top: 1px solid var(--tkw-color-neutral-200); }
  .principle-number { padding-top: 3px; color: var(--tkw-color-neutral-600); font-size: 11px; }
  .principle-list h3 { margin-bottom: 7px; font-size: 17px; }
  .principle-list p { margin-bottom: 0; color: var(--tkw-color-neutral-600); font-size: 12px; line-height: 1.8; }
  .foundations { border-top: 1px solid var(--tkw-color-neutral-200); }
  .section-topline { display: flex; justify-content: space-between; gap: 20px; color: var(--tkw-color-neutral-600); font-size: 10px; letter-spacing: .15em; }
  .foundations-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
  .foundations-heading p { max-width: 340px; margin-bottom: 28px; }
  .foundation-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .foundation-card { display: flex; flex-direction: column; min-height: 360px; }
  .foundation-action { display: flex; flex: 1; flex-direction: column; }
  .foundation-header { gap: 0; }
  .foundation-footer { margin-top: auto; }
  .foundation-card-top { display: flex; justify-content: space-between; color: var(--tkw-color-neutral-600); font-size: 10px; letter-spacing: .1em; }
  .color-mini { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; height: 83px; margin: 32px 0 24px; }
  .color-mini span { border-radius: 5px; }
  .icon-mini { display: flex; align-items: center; gap: 11px; height: 83px; margin: 32px 0 24px; }
  .icon-mini span { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 12px; background: var(--tkw-color-neutral-100); color: var(--tkw-color-neutral-800); font-size: 27px; }
  .foundation-title { margin-bottom: 8px; font-size: 22px; font-weight: 700; }
  .foundation-description { max-width: 450px; font-size: 12px; line-height: 1.9; }
  .foundation-link { display: inline-flex; align-items: center; align-self: flex-start; margin-top: auto; font-size: 12px; font-weight: 700; }
  .color-card .foundation-link { text-decoration: underline; text-underline-offset: .2em; }
  .closing { display: flex; align-items: end; justify-content: space-between; gap: 35px; margin-bottom: 80px; border-top: 1px solid var(--tkw-color-neutral-200); }
  .closing h2 { margin-bottom: 0; }
  .closing > div:last-child { display: flex; flex-direction: column; align-items: flex-start; }
  .closing p { margin-bottom: 20px; }
  footer { border-top: 1px solid var(--tkw-color-neutral-200); color: var(--tkw-color-neutral-600); font-size: 11px; }
  footer .brand { color: var(--tkw-color-neutral-900); }
  @media (max-width: 850px) { .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 62px; } .hero-art { max-width: 700px; } .principles { grid-template-columns: 1fr; gap: 25px; } }
  @media (max-width: 620px) { .hero { padding-top: 45px; } h1 { font-size: clamp(24px, 6.7vw, 42px); } .art-grid { min-height: 230px; } .art-card { padding: 8px 4px; } .art-name, .art-index { font-size: 8px; } .section-shell { padding-top: 70px; padding-bottom: 70px; } .foundations-heading, .closing { align-items: flex-start; flex-direction: column; } .foundations-heading p { margin-bottom: 0; } .foundation-grid { grid-template-columns: 1fr; } .closing { margin-bottom: 0; } footer { flex-wrap: wrap; } }
</style>
